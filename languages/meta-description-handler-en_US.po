#, php-format
msgid "Lub przejdź do <a href=\"%s\">ustawień Meta Description Handler</a>, aby wymusić generowanie tagów (zaawansowane)."
msgstr "Or go to <a href=\"%s\">Meta Description Handler settings</a> to force tag generation (advanced)."

